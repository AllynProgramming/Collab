# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For Atlas, use the format below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/salon_booking_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/salon_booking_db

# JWT Configuration
JWT_SECRET=merz_backend_secret_change_this_in_production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Application Settings
APP_NAME=Merz Beauty Glow Salon Booking System
APP_VERSION=1.0.0
